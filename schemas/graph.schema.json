{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EdgeKind"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "support_count": {
          "default": 1,
          "title": "Support Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "event_ids"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EdgeKind": {
      "enum": [
        "LOADED",
        "STARTED",
        "CREATED",
        "ACCESSED",
        "CONNECTED_TO",
        "RESOLVED",
        "DOWNLOADED",
        "EXECUTED",
        "PARENT_OF",
        "CORRELATED_WITH",
        "OBSERVED",
        "MODIFIED",
        "DELETED",
        "OPENED",
        "RESOLVED_TO",
        "REFERENCES",
        "USES_BINARY",
        "ASSOCIATED_WITH",
        "EXTRACTED_FROM"
      ],
      "title": "EdgeKind",
      "type": "string"
    },
    "JsonValue": {},
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "event_ids"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodeKind": {
      "enum": [
        "Process",
        "File",
        "IP",
        "Domain",
        "User",
        "Registry",
        "Event",
        "MFTRecord",
        "Socket",
        "NetworkFlow",
        "Service",
        "RegistryArtifact",
        "DLL",
        "Module",
        "Driver",
        "MemoryRegion",
        "FileObject"
      ],
      "title": "NodeKind",
      "type": "string"
    },
    "ParserInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ParserInfo",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source_artifact": {
          "$ref": "#/$defs/SourceArtifact"
        },
        "raw_reference": {
          "$ref": "#/$defs/RawReference"
        },
        "parser": {
          "$ref": "#/$defs/ParserInfo"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        },
        "plugin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plugin"
        },
        "memory_image_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Image Id"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "acquisition_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Id"
        },
        "extraction_timestamp": {
          "format": "date-time",
          "title": "Extraction Timestamp",
          "type": "string"
        },
        "row_index": {
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "raw": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Raw",
          "type": "object"
        }
      },
      "required": [
        "source_artifact",
        "raw_reference",
        "parser",
        "tool",
        "extraction_timestamp",
        "row_index",
        "raw"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RawReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "description": "JSON pointer, record number, byte offset, or packet number",
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "locator"
      ],
      "title": "RawReference",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": -100,
          "title": "Score",
          "type": "integer"
        },
        "details": {
          "title": "Details",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "rule",
        "score",
        "details"
      ],
      "title": "Reason",
      "type": "object"
    },
    "Source": {
      "enum": [
        "memory",
        "disk",
        "network"
      ],
      "title": "Source",
      "type": "string"
    },
    "SourceArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-fA-F0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "imported_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imported At"
        }
      },
      "required": [
        "artifact_id",
        "kind"
      ],
      "title": "SourceArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "root_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Root Event Id"
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "title": "IncidentGraph",
  "type": "object"
}
